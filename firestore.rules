rules_version = '2';

// Who can read and write what:
//   users/{uid}, users/{uid}/years/{year}   your finances: your account only
//   shared/{owner}                          Shopping: the owner, plus the
//                                           emails the owner has added
//   members/{email}                         lets an added person find the
//                                           Shopping shared with them
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    // Google sign-in emails are verified; compare in lower case
    function myEmail() {
      return request.auth.token.email_verified == true ? request.auth.token.email.lower() : '';
    }

    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /years/{year} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.json is string
          && request.resource.data.rev is int;
      }
    }

    match /shared/{owner} {
      function isMember() { return signedIn() && myEmail() != '' && myEmail() in resource.data.members; }

      allow read: if isUser(owner) || isMember();
      allow create: if isUser(owner)
        && request.resource.data.owner == owner
        && request.resource.data.members is list
        && request.resource.data.json is string;
      // The owner can change anything. Added people can change the
      // shopping data but not who it's shared with or who owns it.
      allow update: if request.resource.data.json is string
        && request.resource.data.rev is int
        && (isUser(owner)
            || (isMember()
                && request.resource.data.members == resource.data.members
                && request.resource.data.owner == resource.data.owner));
      allow delete: if isUser(owner);
    }

    match /members/{email} {
      allow read: if signedIn() && myEmail() == email;
      // Only the owner who added someone can add, change or remove that record
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
